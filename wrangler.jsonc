{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "budget",
  "main": "./worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./actual-budget-local/packages/desktop-client/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/hf/*",
      "/ort/*"
    ]
  }
}